//
// Google Messages, the Google build's SMS app (decided 24 October 2026, after a
// day's trial: RCS and reactions). Google's own signed APK, kept with its
// signature so Play Store updates install over it, as with Gboard. The APK is
// Google's to distribute, not ZeroS's, so it is not in git: it is copied to the
// build server and checked against the SHA-256 and signing certificate pinned
// in SOURCE (prebuilt/apps/fetch-prebuilts.sh). Only in the Google build
// (config/gapps.mk), which also makes it the default SMS app.
//
// Not privileged: as a privileged app every privileged permission it asks for
// would have to be in MindTheGapps' allowlist or the phone would not boot; the
// trial ran it as an ordinary app and RCS worked.
//
// Native libraries: the APK keeps them compressed and asks Android to extract
// them, which Android does not do for a built-in app until it is updated. The
// APK ships unchanged and its 64-bit libraries go to /product/lib64, where the
// linker looks for built-in product apps. fetch-prebuilts.sh unpacks them from
// the pinned APK into lib/arm64 (not in git).
//
// Generated by build/tools/gen-messages-libs.py; run it again when the APK
// changes.
//
// SPDX-License-Identifier: Apache-2.0
//

android_app_import {
    name: "GoogleMessages",
    apk: "GoogleMessages.apk",
    presigned: true,
    preprocessed: true,
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
    // Replaces LineageOS's Messaging, so the phone has exactly one SMS app.
    overrides: ["messaging"],
    required: [
        "GoogleMessages_libam_expression_jni",
        "GoogleMessages_libandroidx.graphics.path",
        "GoogleMessages_libbarhopper",
        "GoogleMessages_libbugle_c2pa_jni",
        "GoogleMessages_libc2pajni",
        "GoogleMessages_libcpuutils",
        "GoogleMessages_libcrabbyavif_android_parser",
        "GoogleMessages_libdatastore_shared_counter",
        "GoogleMessages_libfilterframework_jni",
        "GoogleMessages_libframesequence",
        "GoogleMessages_libgeller_jni_lite_lib",
        "GoogleMessages_libgif_util_jni",
        "GoogleMessages_libgoogle3",
        "GoogleMessages_libhobbes_jni",
        "GoogleMessages_libimage_processing_util_jni",
        "GoogleMessages_libjni_emojisearch",
        "GoogleMessages_libjnidispatch",
        "GoogleMessages_libjpegli_encoder_jni",
        "GoogleMessages_liblanguage_detector_jni",
        "GoogleMessages_libmagiceditjni",
        "GoogleMessages_libmedia3EffectJNI",
        "GoogleMessages_libmediapipe_tasks_jni",
        "GoogleMessages_libnative_crash_handler_jni",
        "GoogleMessages_libpumpkin_jni_android",
        "GoogleMessages_libscytale_v2_jni",
        "GoogleMessages_libsensitive_classifier_jni",
        "GoogleMessages_libsentencepiece_jni",
        "GoogleMessages_libsurface_util_jni",
        "GoogleMessages_libtartarus_core",
        "GoogleMessages_libtextclassifier3_jni_tclib",
        "GoogleMessages_libtflite_jni",
        "GoogleMessages_libvcdiffjni",
        "GoogleMessages_libzinnia_jni",
    ],
}

cc_prebuilt_library_shared {
    name: "GoogleMessages_libam_expression_jni",
    stem: "libam_expression_jni",
    srcs: ["lib/arm64/libam_expression_jni.so"],
    compile_multilib: "64",
    product_specific: true,
    check_elf_files: false,
    strip: {
