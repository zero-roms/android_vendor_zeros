<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.zeroroms.tools">

    <uses-permission android:name="android.permission.DUMP" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_bug_report"
        android:label="@string/app_name">

        <service
            android:name=".BugReportTileService"
            android:exported="true"
            android:icon="@drawable/ic_bug_report"
            android:label="@string/bug_report_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Google setup's Assistant opt-in without the Google app (bug B10) -->
        <activity
            android:name=".OpaSkipActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter android:priority="-100">
                <action android:name="com.google.android.apps.gsa.opa.OPA_OPT_IN_WRAPPED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
